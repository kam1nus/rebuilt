# Documentation only: Flutter does not load this file automatically.
# Keep real values in a local, untracked .env file or secret manager, then
# pass them at run time with --dart-define as shown in README.md.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Set this only in Supabase Edge Function secrets; never place it in the app.
GEMINI_API_KEY=YOUR_PROVIDER_KEY
